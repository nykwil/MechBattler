{
  "name": "mechbattler",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "game:test": "npm run test --workspace=@mechbattler/game",
    "game:build": "npm run build --workspace=@mechbattler/game",
    "game:audit": "npm run audit --workspace=@mechbattler/game",
    "game:balance": "npm run balance --workspace=@mechbattler/game",
    "game:checkpoints": "npm run checkpoints --workspace=@mechbattler/game",
    "game:match-balance": "npm run match-balance --workspace=@mechbattler/game",
    "game:loop": "npm run loop --workspace=@mechbattler/game --",
    "game:loop-report": "npm run loop-report --workspace=@mechbattler/game --",
    "sim:test": "npm run test --workspace=@mechbattler/sim",
    "sim:build": "npm run build --workspace=@mechbattler/sim",
    "web:dev": "npm run dev --workspace=@mechbattler/web",
    "web:test": "npm run test --workspace=@mechbattler/web",
    "web:build": "npm run build --workspace=@mechbattler/web",
    "prototype:dev": "npm run dev --workspace=@mechbattler/physics-prototype",
    "prototype:test": "npm run test --workspace=@mechbattler/physics-prototype",
    "prototype:build": "npm run build --workspace=@mechbattler/physics-prototype",
    "sim:hitrate": "npm run hitrate --workspace=@mechbattler/sim --",
    "sim:balance": "npm run balance --workspace=@mechbattler/sim --",
    "sim:adapt": "npm run adapt --workspace=@mechbattler/sim --",
    "sim:diversity": "npm run diversity --workspace=@mechbattler/sim --",
    "verify": "npm run game:test && npm run game:audit && npm run game:build && npm run sim:test && npm run sim:build && npm run web:test && npm run web:build && npm run verify:balance",
    "verify:balance": "(npm run game:balance -- 1; npm run game:match-balance -- 1; npm run sim:balance -- 10; npm run sim:diversity -- 5); true",
    "balance:collect": "npm run sim:balance -- --json artifacts/balance.json && npm run sim:diversity -- --json artifacts/diversity.json",
    "balance:report": "node scripts/balance-report.mjs",
    "web:shot": "node scripts/drive.mjs",
    "web:audit": "node scripts/audit.mjs",
    "web:campaign": "node scripts/campaign-smoke.mjs"
  }
}
